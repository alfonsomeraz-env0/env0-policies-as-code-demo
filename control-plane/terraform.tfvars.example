# This repository is public, so env zero can read it without a VCS connection.
# Fork it and point repo_url at your fork if you want to change the policies.
repo_url      = "https://github.com/alfonsomeraz-env0/env0-policies-as-code-demo"
repo_revision = "main"

# Needed only for a private fork. Find it in env zero: Organization Settings > VCS.
# vcs_connection_id = "00000000-0000-0000-0000-000000000000"

# Optional: attach existing AWS credentials to both projects.
# cloud_credentials_id = "00000000-0000-0000-0000-000000000000"

# Optional: nest the demo under an existing env zero project.
# parent_project_id = "00000000-0000-0000-0000-000000000000"
